# Server-side only. Never prefix this key with VITE_.
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# DeepSeek V4 defaults. Override only when intentionally changing provider settings.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Runtime selection. "direct" preserves the existing DeepSeek JSON integration.
# Set to "harness" only after starting agent-runtime/server.py.
AI_RUNTIME_MODE=direct
DSH_RUNTIME_URL=http://127.0.0.1:8090
DSH_RUNTIME_TIMEOUT_MS=180000

# ChatGPT login is the default. Use the in-app Connect Codex button or run `codex login`.
# Set CODEX_AUTH_MODE=api-key only when intentionally using usage-based API access.
CODEX_AUTH_MODE=chatgpt
CODEX_API_KEY=
CODEX_MODEL=
